# Polymarket V2 Configuration Settings

# Ticker symbol to trade (e.g. BTC, ETH, SOL, DOGE)
TICKER=BTC

# Internal WebSocket Spot Feed settings (relay of Chainlink Oracle CEX median)
POLYMARKET_WSS_URL=wss://ws-live-data.polymarket.com/
POLYMARKET_WS_PAYLOAD={"type": "subscribe", "topic": "crypto_prices_chainlink"}

# Polymarket CLOB API and Order Book WebSocket details
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_REST_URL=https://clob.polymarket.com

# Target contract details (YES/NO tokens)
YES_TOKEN_ID=0xYourYesTokenId
NO_TOKEN_ID=0xYourNoTokenId

# Expiration Settings
EXPIRATION_TIMESTAMP=0.0

# Strike Price Presumption (K) used during trading before resolution
PRESUMED_STRIKE_PRICE=67500.0

# Capital & Sizing Settings
INITIAL_CAPITAL=10000.0
KELLY_FRACTION=0.15
GAS_FEE_USD=0.03
MIN_EXPECTED_VALUE=0.005
MIN_ACCEPTABLE_MARGIN_BPS=5.0
ABSOLUTE_MAX_SLIPPAGE_BPS=150.0
MAX_POSITION_SIZE_USD=5000.0
TAKER_ENABLED=True


# Volatility & Drift settings (Merton Jump Diffusion)
DEFAULT_LAMBDA=4000.0
DEFAULT_MU_J=0.0001
DEFAULT_SIGMA_J=0.0015
DEFAULT_SIGMA=0.25
VOL_ROLLING_WINDOW_SEC=300
OFI_DRIFT_MULTIPLIER=-1e-6

# Hawkes stochastic intensity parameters (Bivariate Mutually Exciting Process)
HAWKES_LAMBDA_0=4000.0
HAWKES_KAPPA_SELF=3.0
HAWKES_KAPPA_CROSS=1.0
HAWKES_BETA=5.0
USE_LOCAL_INFORMED_DRIFT=False

# Risk Settings
DESYNC_Z_SCORE=2.0
POF_LATENCY_TAU=15.0
POF_DECAY_K=0.25
ORACLE_NOISE_BPS=1.5
PIN_RISK_SECONDS=5.0
COOLDOWN_PERIOD_SEC=10

# Logging Directory
LOG_DIR=logs
