# Polymarket V2 configuration. Copy to .env and edit. Every value has a default in
# config/settings.py; only the keys below are read by the code.

# ── Market selection ──────────────────────────────────────────────────────────
# Ticker symbol (BTC, ETH, SOL, ...)
TICKER=BTC

# Cycle series. Polymarket runs parallel Up/Down series per ticker with different
# lengths; the event slug is "<ticker>-updown-<MARKET_SLUG_TYPE>-<cycle start ts>"
# and cycle boundaries are multiples of CYCLE_DURATION_SEC on the Unix epoch.
# Change both values together. Presets:
#   5-minute : CYCLE_DURATION_SEC=300    MARKET_SLUG_TYPE=5m   (default)
#   4-hour   : CYCLE_DURATION_SEC=14400  MARKET_SLUG_TYPE=4h
CYCLE_DURATION_SEC=300
MARKET_SLUG_TYPE=5m

# Pricing strategy: merton (Hawkes-Merton) | legacy_merton (Poisson + OFI logit shift)
STRATEGY_NAME=merton

# ── Feeds ─────────────────────────────────────────────────────────────────────
POLYMARKET_WSS_URL=wss://ws-live-data.polymarket.com/
POLYMARKET_WS_PAYLOAD={"type": "subscribe", "topic": "crypto_prices_chainlink"}
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_REST_URL=https://clob.polymarket.com

# ── Paper capital and fees ────────────────────────────────────────────────────
INITIAL_CAPITAL=10000.0
KELLY_FRACTION=0.05
GAS_FEE_USD=0.03
TAKER_FEE_MULTIPLIER=0.072
MIN_ORDER_USD=1.0
PANIC_CONCESSION=0.15

# ── Pricing model (Hawkes-Merton) ─────────────────────────────────────────────
DEFAULT_SIGMA=0.25
VOL_ROLLING_WINDOW_SEC=300
EMA_HALFLIFE_SEC=3.0
DEFAULT_MU_J=0.0001
DEFAULT_SIGMA_J=0.0015
HAWKES_LAMBDA_0=4000.0
HAWKES_KAPPA_SELF=3.0
HAWKES_KAPPA_CROSS=1.0
HAWKES_BETA=5.0
OFI_DRIFT_MULTIPLIER=-1e-6
USE_LOCAL_INFORMED_DRIFT=False
# legacy_merton only (homogeneous Poisson intensity + OFI logit shift)
DEFAULT_LAMBDA=4000.0
OFI_LOGIT_BETA=0.5
OFI_NORM_EMA_ALPHA=0.1

# ── Market-making router ──────────────────────────────────────────────────────
MM_RISK_AVERSION=2.5
MM_MIN_FEE_BUFFER=0.005
MM_TOXICITY_BUFFER=0.005
MM_MAKER_SIZE=100.0
MM_MAX_INVENTORY=500.0
MM_UNWIND_THRESHOLD=0.01
MM_TAKER_EDGE_EPSILON=0.015
MM_TICK_SIZE=0.01
MM_REQUOTE_THRESHOLD=0.01

# ── Divergence velocity filter (toxic-flow guard) ─────────────────────────────
DIVERGENCE_WINDOW_SECONDS=60.0
VELOCITY_LOOKBACK_SECONDS=10.0
V_MAX=0.005
GAMMA=2.0

# ── Dashboard and logging ─────────────────────────────────────────────────────
WEB_SERVER_ENABLED=True
WEB_SERVER_HOST=localhost
WEB_SERVER_PORT=8080
UI_BROADCAST_THROTTLE_HZ=4.0
LOG_DIR=logs
